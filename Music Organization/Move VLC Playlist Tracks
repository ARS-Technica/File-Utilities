def backup_playlist_file(original_playlist_path, original_songs):
    """
    Back up the original playlist file before overwriting it with the updated tracks.
    """
    # Resolve the path to fetch its on-disk name from Windows
    playlist_file = Path(original_playlist_path).resolve() #resolve is case-sensitive

    # Extract stem and suffix matching the actual file on disk
    original_stem = playlist_file.stem      # e.g. 'Favorites'
    original_ext = playlist_file.suffix     # e.g. '.XSPF'
    # This prevents all output files from being saved as lowercase filesnames

    ext = playlist_file.suffix.lower()

    # If backup_choice in ('y', 'yes', 'ye', 'es', 'ys'):
    custom_backup_name = input("\nEnter a new name for the backup file (or press Enter for default [<original_name>_backup<extension>]): ").strip().strip("'\"")

    # If the user provides a custom name
    if custom_backup_name:
        # Ensure the custom name carries the proper extension
        if not custom_backup_name.lower().endswith(ext):
            backup_filename = f"{custom_backup_name}{original_ext}" # Change output name!
            backup_path = playlist_file.parent / backup_filename
        else:
            backup_path = playlist_file.parent / custom_backup_name

    # If the user does not provide a custom name, use the default backup naming convention
    else:
        # Construct output filename using the true on-disk casing
        backup_filename = f"{original_stem}_backup{original_ext}" # Change output name!
        backup_path = playlist_file.parent / backup_filename

    # Create backup copy of original file
    try: # Yes, this needs to be a try/except block to catch any file writing errors
        if ext == '.xspf':
            export_as_xspf(backup_path, original_songs)

        else:
            export_as_m3u(backup_path, original_songs)

        print(f"\nSuccessfully created backup of the original playlist file!")
        # print(f"Located at: {output_path.resolve()}")
        # resolve() can rewrite casing based on Windows' drive index
        print(f"Located at: {backup_path}")

        # Return the output path so main() knows where the new file is
        return backup_path

    except Exception as e:
        print(f"\nError saving playlist file: {e}")
        return None


def export_as_m3u(output_path, songs):
    """
    Write updated song tracks to an .m3u (plain text) playlist file.
    """
    with open(output_path, "w", encoding="utf-8") as file:
        file.write("#EXTM3U\n")

        for song in songs:
            file.write(f"#EXTINF:-1,{song['title']}\n")
            file.write(f"{song['path']}\n")


def export_as_xspf(output_path, songs):
    """
    Write updated song tracks to an .xspf (XML) playlist file.
    """
    root = ET.Element("playlist", version="1", xmlns="http://xspf.org/ns/0/")
    track_list = ET.SubElement(root, "trackList")

    for song in songs:
        track = ET.SubElement(track_list, "track")

        title_el = ET.SubElement(track, "title")
        title_el.text = song['title']

        location_el = ET.SubElement(track, "location")
        clean_path = song['path'].replace('\\', '/')
        encoded_uri = "file:///" + quote(clean_path, safe="/:")
        location_el.text = encoded_uri

    tree = ET.ElementTree(root)
    ET.indent(tree, space="  ")
    tree.write(output_path, encoding="utf-8", xml_declaration=True)
   

def output_playlist(file_path, playlist, header=""):
    """
    Outputs the playlist to the console.
    """
    if header:
        print(f"\n=== {header} ===")

    print(f"There are {len(playlist)} songs in this playlist.")
    print(f"Tracks found in {file_path}:\n")

    # Display updated tracks if changes were made
    for song in playlist:
        # print(f"Title: {song['title']}, Path: {song['path']}")
        print(f"Title: {song['title']}")
        print(f"Path/URL: <{song['path']}>\n", flush=True)
        # wrapping the path string in angle brackets < and > signals to terminal parsers that the entire enclosed string is a single path unit

    return None


def parse_xspf_playlist(file_path):
    """
    Parses XML-based XSPF playlists safely with or without namespaces.
    """
    songs = []

    # Parse the XML file
    tree = ET.parse(file_path)
    root = tree.getroot()

    # Define the XSPF namespace to find elements correctly
    namespace = {'ns': 'http://xspf.org/ns/0/'}

    # First attempt: standard XSPF namespace query
    tracks = root.findall('.//ns:track', namespace)

    # Fallback: If no tracks found using namespace,  ignore XML namespaces
    if not tracks:
        # {*}`track` matches any tag named 'track' regardless of namespace
        tracks = root.findall('.//{*}track')
    # This check ensures that we can still find tracks even if the XML uses a 
    # different namespace or no namespace at all. It prevents the script from 
    # failing to find tracks in playlists that don't strictly adhere to the 
    # expected namespace. (Note: This is a response to "No tracks found in the 
    # specified playlist file." displaying even when the file is valid.)

    # Find all <track> tags inside <trackList>
    for track in tracks:
        # Try namespace search first, then wildcard tag search
        title_element = track.find('ns:title', namespace)
        # Extract text if the elements exist
        if title_element is None:
            title_element = track.find('.//{*}title')

        location_element = track.find('ns:location', namespace) if 'ns' in locals() else None

        if location_element is None:
            location_element = track.find('{*}location')

        title = title_element.text if title_element is not None and title_element.text else "Unknown Title"
        location = location_element.text if location_element is not None and location_element.text else "Unknown Location"

        # VLC encodes local file paths as URLs (e.g., file:///C:/Music/song.mp3)
        # Decode URL encoding (%20 -> space) and remove zero-width spaces
        clean_path = unquote(location).replace('\u200b', '')

        # Strip file:/// URI scheme for clean local paths
        if clean_path.startswith('file:///'):
            clean_path = clean_path[8:]
        elif clean_path.startswith('file://'):
            clean_path = clean_path[7:]

        # Convert forward slashes to Windows backslashes
        clean_path = clean_path.replace('/', '\\')

        # Collect into dictionary so the returned list has data
        songs.append({"title": title, "path": clean_path})

    # output_playlist(file_path, songs) 

    return songs


def parse_m3u_playlist(file_path):
    """
    Parses plain-text M3U/M3U8 playlists.
    """
    songs = []

    # All reading happens INSIDE this with block
    with open(file_path, 'r', encoding='utf-8', errors='ignore') as file:
        current_title = "Unknown Title"
        for line in file:
            line = line.strip()
            
            # Skip empty lines or M3U headers
            if not line or line == "#EXTM3U":
                continue

            # Grab metadata line (#EXTINF:123,Artist - Title)
            if line.startswith("#EXTINF:"):
                parts = line.split(',', 1)
                if len(parts) > 1:
                    current_title = parts[1]
            
            # Standard line is the actual path/URL
            elif not line.startswith("#"):
                clean_path = unquote(line).replace('\u200b', '')
                clean_path = clean_path.replace('/', '\\')
                songs.append({"title": current_title, "path": clean_path})
                current_title = "Unknown Title"  # Reset for next track            

    # output_playlist(file_path, songs)

    return songs


def relocate_paths(songs):
    """
    Prompts user for find-and-replace strings to rewrite track paths.
    """
    # Prompt for the new path segment to replace it with
    old_segment = input("Enter the path text to replace (e.g., C:\\OldFolder): ").strip().strip("'\"")

    # End function if no new path segment is entered as a replacement
    if not old_segment:
        print("No search text entered. Skipping path relocation.")
        return songs   

    # Prompt for the text to replace old path segment
    new_segment = input(f"You have chosen to replace '{old_segment}' in the track paths.\n\nEnter the new replacement path text: ").strip().strip("'\"")

    replacements_count = 0
    updated_songs = []

    for song in songs:
        original_path = song['path']
        if old_segment.lower() in original_path.lower():
            new_path = original_path.replace(old_segment, new_segment)
            replacements_count += 1
        else:
            new_path = original_path

        updated_songs.append({"title": song['title'], "path": new_path})

    print(f"\nReplacement complete! Updated paths for {replacements_count} out of {len(songs)} tracks.")
    return updated_songs


def replace_original_playlist(original_playlist_path, new_playlist_path):
    """
    Renames the original playlist file to a backup (.bak) 
    and replaces the original file with the new playlist.
    """
    # Resolve the path to fetch its on-disk name from Windows
    playlist_file = Path(original_playlist_path).resolve() #resolve is case-sensitive
    new_file = Path(new_playlist_path).resolve()

    # Extract stem and suffix matching the actual file on disk
    original_stem = playlist_file.stem      # e.g. 'Favorites'
    original_ext = playlist_file.suffix     # e.g. '.XSPF'
    # This prevents all output files from being saved as lowercase filesnames

    # Construct output filename using the true on-disk casing
    backup_filename = f"{original_stem}.{original_ext}.bak" # Change output name!
    backup_path = playlist_file.parent / backup_filename

    # Try to back up the original playlist file before replacing it
    try:
        # Backup the original playlist file before replacing it
        if playlist_file .exists():
            # Rename the original playlist to a backup file
            os.rename(playlist_file, backup_path)
            print("\nSuccessfully backed up the original playlist to:")
            print(f"\n{backup_path}")

            # Overwrite the original playlist name with the updated playlist file
            os.replace(new_file, playlist_file)
            print(f"\nSuccessfully replaced the original playlist with the new playlist.")

            return playlist_file  # Return the original playlist path for reference

    # If an error occurs during backup or replacement, inform the user and provide options
