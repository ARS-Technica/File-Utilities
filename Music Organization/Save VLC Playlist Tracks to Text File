"""
Print out VLC Playlist Tracks
Created: July 18, 2026

Description: Use Python to read VLC playlist files (.xspf, .m3u, .m3u8) 
             and export track details into a clean text file locally.

An XSPF (XML Shareable Playlist Format) file is a 
type of XML file. You can read it using Python's 
built-in xml.etree.ElementTree library to find all the 
track locations.
"""

from logging import root
import os # For prompting user for a file path
from pathlib import Path # For parsing and validating file paths
import sys # Reconfigures filenames to UTF-8 to avoid UnicodeDecodeError when printing paths
from urllib.parse import unquote  # For decoding URL-encoded paths
import xml.etree.ElementTree as ET


# Force stdout to use UTF-8 if the environment supports it
# Force stdout to use UTF-8 if standard stream supports reconfigure
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.recon


def parse_xspf_playlist(file_path):
    """
    Parses XML-based VLC playlists.
    """
    songs = []

    # Parse the XML file
    tree = ET.parse(file_path)
    root = tree.getroot()

    # Define the XSPF namespace to find elements correctly
    namespace = {'ns': 'http://xspf.org/ns/0/'}

    # First attempt: standard XSPF namespace query
    tracks = root.findall('.//ns:track', namespace)

    # Fallback: If no tracks found using namespace,  ignore XML namespaces
    if not tracks:
        # {*}`track` matches any tag named 'track' regardless of namespace
        tracks = root.findall('.//{*}track')
    # This check ensures that we can still find tracks even if the XML uses a 
    # different namespace or no namespace at all. It prevents the script from 
    # failing to find tracks in playlists that don't strictly adhere to the 
    # expected namespace. (Note: This is a response to "No tracks found in the 
    # specified playlist file." displaying even when the file is valid.)

    # Find all <track> tags inside <trackList>
    for track in tracks:
        # Try namespace search first, then wildcard tag search
        title_element = track.find('ns:title', namespace)
        # Extract text if the elements exist
        if title_element is None:
            title_element = track.find('.//{*}title')

        location_element = track.find('ns:location', namespace) if 'ns' in locals() else None

        if location_element is None:
            location_element = track.find('{*}location')

        title = title_element.text if title_element is not None and title_element.text else "Unknown Title"
        location = location_element.text if location_element is not None and location_element.text else "Unknown Location"

        # VLC encodes local file paths as URLs (e.g., file:///C:/Music/song.mp3)
        # Decode URL encoding (%20 -> space) and remove zero-width spaces
        clean_path = unquote(location).replace('\u200b', '')

        # Strip file:/// URI scheme for clean local paths
        if clean_path.startswith('file:///'):
            clean_path = clean_path[8:]
        elif clean_path.startswith('file://'):
            clean_path = clean_path[7:]

        # Collect into dictionary so the returned list has data
        songs.append({"title": title, "path": clean_path})            

    output_playlist(file_path, songs) 

    return songs


def parse_m3u_playlist(file_path):
    """
    Parses plain-text M3U/M3U8 playlists.
    """
    songs = []

    with open(file_path, 'r', encoding='utf-8', errors='ignore') as file:
        current_title = "Unknown Title"
        for line in file:
            line = line.strip()
            
            # Skip empty lines or M3U headers
            if not line or line == "#EXTM3U":
                continue

            # Grab metadata line (#EXTINF:123,Artist - Title)
            if line.startswith("#EXTINF:"):
                parts = line.split(',', 1)
                if len(parts) > 1:
                    current_title = parts[1]
            
            # Standard line is the actual path/URL
            elif not line.startswith("#"):
                clean_path = unquote(line).replace('\u200b', '')
                songs.append({"title": current_title, "path": clean_path})
                current_title = "Unknown Title"  # Reset for next track            

    output_playlist(file_path, songs)

    return None


def output_playlist(file_path, playlist):
    """
    Outputs the playlist to the console.
    """
    print(f"There are {len(playlist)} songs in this playlist.")
    print(f"Tracks found in {file_path}:\n")

    for song in playlist:
        # print(f"Title: {song['title']}, Path: {song['path']}")

        print(f"Title: {song['title']}")
        print(f"Path/URL: {song['path']}\n", flush=True)  

    return None


def save_playlist_to_file(playlist_path, songs):
    """
    Saves the extracted track details into a text file in the same 
    directory as the input playlist file.
    """
    playlist_file = Path(playlist_path)

    # Create output filename: e.g., 'favorites_tracks.txt'
    output_filename = f"{playlist_file.stem}_tracks.txt"
    output_path = playlist_file.parent / output_filename

    try:
        with open(output_path, 'w', encoding='utf-8') as out_file:
            out_file.write(f"Playlist Track Export: {playlist_file.name}\n")
            out_file.write(f"Total Tracks: {len(songs)}\n")

        for idx, song in enumerate(songs, start=1):
            out_file.write(f"Track {idx}:\n")
            out_file.write(f"  Title: {song['title']}\n")
            out_file.write(f"  Path : {song['path']}\n\n")

        print(f"\nSuccessfully exported {len(songs)} tracks to:")
        print(f"{output_path.resolve()}")

        return output_path

    except Exception as e:
        print(f"\nError saving text file: {e}")
        return None


def main():
    """
    Main function to execute the playlist parsing logic.
    """
    # Verify that the script is running in an environment that supports input()
    try:
        # Prompt the user for the file path
        user_input = input("Enter the full path to your playlist file: ")
    except (EOFError, RuntimeError):
        print("\nError: This IDE environment does not support interactive terminal input.")
        print("Please run this script from a real terminal or enable 'External Console' in your IDE settings.")

        return # End program

    # Prevent program from hanging due to buffer deadlock
    sys.stdout.flush()  # Force the terminal to process the input immediately

    # Clean up accidental spaces or quotes around the path
    clean_input = user_input.strip().strip("'\"")
  
    # Visual feedback so you know it moved past input()
    print(f"Processing: {clean_input}...") # Proves request isn't frozen
    sys.stdout.flush()

    # Convert to a Path object for easier handling (so we can check .suffix)
    file_path = Path(clean_input).expanduser()

    # Define the extensions we are looking for
    extensions = ('.xspf', '.m3u', '.m3u8')

    print("Checking if file exists...", flush=True)

    # Check if the file actually exists before running
    if file_path.exists():
        # Save a few lines of code
        ext = file_path.suffix.lower()

        if ext in extensions:
            # Route to the correct parsing function based on extension
            if ext == '.xspf':
                songs = parse_xspf_playlist(file_path)
            else:
                songs = parse_m3u_playlist(file_path)

            # Check that there are tracks in the playlist before attempting to save
            if songs:
                save_playlist_to_file(file_path, songs)
            else:
                print("\nNo tracks found in the specified playlist file.")

        else:
            print(f"\nError: '{ext}' is not a supported playlist format. Please use .xspf, .m3u, or .m3u8.")
    else:
        print(f"\nError: Could not find a file at '{file_path}'. Please check the path and try again.")


if __name__ == "__main__":
    main()


